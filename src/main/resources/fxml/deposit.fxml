<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.igirepay.lab3.controller.DepositController">

    <top>
        <VBox style="-fx-padding: 16 20 6 20;">
            <Label text="Deposit Money" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
            <Label text="Add funds to your wallet or savings account" style="-fx-font-size: 12; -fx-text-fill: #666;"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" style="-fx-padding: 0;">
            <VBox spacing="14" style="-fx-padding: 40;" minWidth="420">
                <GridPane hgap="12" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints minWidth="150"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Account:"       GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="accountCombo" promptText="Select account"
                              maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="Amount (RWF):"  GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="amountField" promptText="e.g. 5000"
                               GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                </GridPane>
                <Button text="Deposit" onAction="#handleDeposit" prefWidth="160"
                        style="-fx-font-size: 13;"/>
                <Label fx:id="resultLabel" text="" wrapText="true"/>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox style="-fx-padding: 12;">
            <Button text="← Back to Dashboard" onAction="#handleBack" prefWidth="180"/>
        </HBox>
    </bottom>
</BorderPane>
