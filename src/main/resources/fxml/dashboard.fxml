<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.igirepay.lab3.controller.DashboardController">

    <!-- ── Top header ── -->
    <top>
        <VBox style="-fx-padding: 16 20 10 20; -fx-spacing: 4;
                     -fx-background-color: #2c3e50;">
            <Label fx:id="welcomeLabel"
                   style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Account Overview"
                   style="-fx-font-size: 12; -fx-text-fill: #bdc3c7;"/>
        </VBox>
    </top>

    <!-- ── Left sidebar ── -->
    <left>
        <VBox spacing="6"
              style="-fx-padding: 20 12 20 12; -fx-background-color: #34495e;
                     -fx-min-width: 160; -fx-pref-width: 160;">

            <Label text="TRANSACTIONS"
                   style="-fx-font-size: 10; -fx-text-fill: #95a5a6;
                          -fx-padding: 8 0 4 4; -fx-font-weight: bold;"/>
            <Button text="Deposit"
                    onAction="#handleDeposit" maxWidth="Infinity"
                    style="-fx-background-color: #3d566e; -fx-text-fill: white;
                           -fx-alignment: center-left; -fx-padding: 8 12;"/>
            <Button text="Withdraw"
                    onAction="#handleWithdraw" maxWidth="Infinity"
                    style="-fx-background-color: #3d566e; -fx-text-fill: white;
                           -fx-alignment: center-left; -fx-padding: 8 12;"/>
            <Button text="Transfer"
                    onAction="#handleTransfer" maxWidth="Infinity"
                    style="-fx-background-color: #3d566e; -fx-text-fill: white;
                           -fx-alignment: center-left; -fx-padding: 8 12;"/>
            <Button text="Savings"
                    onAction="#handleSavings" maxWidth="Infinity"
                    style="-fx-background-color: #3d566e; -fx-text-fill: white;
                           -fx-alignment: center-left; -fx-padding: 8 12;"/>
            <Button text="Loan"
                    onAction="#handleLoan" maxWidth="Infinity"
                    style="-fx-background-color: #3d566e; -fx-text-fill: white;
                           -fx-alignment: center-left; -fx-padding: 8 12;"/>

            <Label text="ACCOUNT"
                   style="-fx-font-size: 10; -fx-text-fill: #95a5a6;
                          -fx-padding: 12 0 4 4; -fx-font-weight: bold;"/>
            <Button text="Transaction History"
                    onAction="#handleHistory" maxWidth="Infinity"
                    style="-fx-background-color: #3d566e; -fx-text-fill: white;
                           -fx-alignment: center-left; -fx-padding: 8 12;"/>
            <Button text="Reports"
                    onAction="#handleReports" maxWidth="Infinity"
                    style="-fx-background-color: #3d566e; -fx-text-fill: white;
                           -fx-alignment: center-left; -fx-padding: 8 12;"/>
            <Button text="Manage Accounts"
                    onAction="#handleManageAccounts" maxWidth="Infinity"
                    style="-fx-background-color: #3d566e; -fx-text-fill: white;
                           -fx-alignment: center-left; -fx-padding: 8 12;"/>
            <Button text="Change PIN"
                    onAction="#handleChangePin" maxWidth="Infinity"
                    style="-fx-background-color: #3d566e; -fx-text-fill: white;
                           -fx-alignment: center-left; -fx-padding: 8 12;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="Logout"
                    onAction="#handleLogout" maxWidth="Infinity"
                    style="-fx-background-color: #c0392b; -fx-text-fill: white;
                           -fx-alignment: center-left; -fx-padding: 8 12;"/>
        </VBox>
    </left>

    <!-- ── Center ── -->
    <center>
        <VBox style="-fx-padding: 24 30; -fx-alignment: top-left;">

            <!-- Empty state — shown when customer has no accounts -->
            <VBox fx:id="emptyStateBox" spacing="10"
                  style="-fx-alignment: center-left;">
                <Label text="No accounts yet"
                       style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #7f8c8d;"/>
                <Label text="Go to Manage Accounts to create your wallet or savings account."
                       wrapText="true"
                       style="-fx-font-size: 12; -fx-text-fill: #95a5a6;"/>
                <Button text="Manage Accounts" onAction="#handleManageAccounts" prefWidth="160"/>
            </VBox>

            <!-- Balance cards — pinned to top-left -->
            <HBox fx:id="cardsBox" spacing="16" VBox.vgrow="NEVER">

                <!-- Wallet card -->
                <VBox spacing="4" style="-fx-background-color: #1a6fa8;
                                         -fx-background-radius: 8;
                                         -fx-padding: 16 24;
                                         -fx-min-width: 170; -fx-pref-width: 170;
                                         -fx-pref-height: 80; -fx-max-height: 80;">
                    <Label text="WALLET"
                           style="-fx-font-size: 10; -fx-font-weight: bold;
                                  -fx-text-fill: #a8cce8;"/>
                    <Label fx:id="walletBalanceLabel" text="0.00 RWF"
                           style="-fx-font-size: 16; -fx-font-weight: bold;
                                  -fx-text-fill: white;" wrapText="true"/>
                </VBox>

                <!-- Savings card -->
                <VBox spacing="4" style="-fx-background-color: #1e7e4a;
                                         -fx-background-radius: 8;
                                         -fx-padding: 16 24;
                                         -fx-min-width: 170; -fx-pref-width: 170;
                                         -fx-pref-height: 80; -fx-max-height: 80;">
                    <Label text="SAVINGS"
                           style="-fx-font-size: 10; -fx-font-weight: bold;
                                  -fx-text-fill: #a8d5b8;"/>
                    <Label fx:id="savingsBalanceLabel" text="0.00 RWF"
                           style="-fx-font-size: 16; -fx-font-weight: bold;
                                  -fx-text-fill: white;" wrapText="true"/>
                </VBox>

                <!-- Loan card -->
                <VBox spacing="4" style="-fx-background-color: #b05a00;
                                         -fx-background-radius: 8;
                                         -fx-padding: 16 24;
                                         -fx-min-width: 170; -fx-pref-width: 170;
                                         -fx-pref-height: 80; -fx-max-height: 80;">
                    <Label text="LOAN BALANCE"
                           style="-fx-font-size: 10; -fx-font-weight: bold;
                                  -fx-text-fill: #f0c89a;"/>
                    <Label fx:id="loanBalanceLabel" text="No active loan"
                           style="-fx-font-size: 14; -fx-font-weight: bold;
                                  -fx-text-fill: white;" wrapText="true"/>
                </VBox>

            </HBox>
        </VBox>
    </center>

</BorderPane>
