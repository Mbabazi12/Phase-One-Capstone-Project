<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.igirepay.lab3.controller.AccountController"
            fitToWidth="true" fitToHeight="false"
            style="-fx-padding: 0;">

    <VBox spacing="14" style="-fx-padding: 40;" minWidth="420">

        <Label text="Account Management" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
        <Label text="Create new accounts or manage existing ones."
               style="-fx-font-size: 12; -fx-text-fill: #666;"/>

        <!-- Create buttons -->
        <HBox spacing="10">
            <Button text="Create Wallet Account"  onAction="#handleCreateWallet"  prefWidth="190"/>
            <Button text="Create Savings Account" onAction="#handleCreateSavings" prefWidth="190"/>
        </HBox>

        <Label text="Your Accounts (select one to activate or deactivate):"
               style="-fx-font-weight: bold;"/>
        <ListView fx:id="accountListView" prefHeight="220"/>

        <!-- Deactivate / Reactivate side by side -->
        <HBox spacing="10">
            <Button text="Deactivate Selected"
                    onAction="#handleDeactivateSelected"
                    prefWidth="190"
                    style="-fx-text-fill: #c0392b;"/>
            <Button text="Reactivate Selected"
                    onAction="#handleReactivateSelected"
                    prefWidth="190"
                    style="-fx-text-fill: #27ae60;"/>
        </HBox>

        <Label text="Note: only accounts with zero balance can be deactivated."
               style="-fx-font-size: 11; -fx-text-fill: #888;"/>

        <Label fx:id="messageLabel" text="" wrapText="true"/>

        <Button text="← Back to Dashboard" onAction="#handleBack" prefWidth="180"/>
    </VBox>
</ScrollPane>
