<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.igirepay.lab3.controller.TransactionController"
            fitToWidth="true" fitToHeight="false"
            style="-fx-padding: 0;">

    <VBox spacing="20" style="-fx-padding: 30;" minWidth="500">

        <Label text="Transactions" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

        <!-- Deposit -->
        <TitledPane text="Deposit" collapsible="false">
            <GridPane hgap="10" vgap="8" style="-fx-padding: 12;">
                <columnConstraints>
                    <ColumnConstraints minWidth="130"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Account:"      GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="depositAccountCombo" promptText="Select account"
                          maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Amount (RWF):" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="depositAmountField" promptText="e.g. 5000"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Button text="Deposit" onAction="#handleDeposit" prefWidth="100"
                        GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            </GridPane>
        </TitledPane>

        <!-- Withdraw -->
        <TitledPane text="Withdraw" collapsible="false">
            <GridPane hgap="10" vgap="8" style="-fx-padding: 12;">
                <columnConstraints>
                    <ColumnConstraints minWidth="130"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Account:"      GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="withdrawAccountCombo" promptText="Select account"
                          maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Amount (RWF):" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="withdrawAmountField" promptText="e.g. 2000"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="PIN:"          GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <PasswordField fx:id="withdrawPinField" promptText="5-digit PIN"
                               GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Button text="Withdraw" onAction="#handleWithdraw" prefWidth="100"
                        GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>
        </TitledPane>

        <!-- Transfer -->
        <TitledPane text="Transfer" collapsible="false">
            <GridPane hgap="10" vgap="8" style="-fx-padding: 12;">
                <columnConstraints>
                    <ColumnConstraints minWidth="130"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="From Account:"    GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="transferAccountCombo" promptText="Select account"
                          maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Recipient Phone:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="transferRecipientPhoneField" promptText="10-digit phone number"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Amount (RWF):"    GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="transferAmountField" promptText="e.g. 10000"
                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="PIN:"             GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <PasswordField fx:id="transferPinField" promptText="5-digit PIN"
                               GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Button text="Transfer" onAction="#handleTransfer" prefWidth="100"
                        GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            </GridPane>
        </TitledPane>

        <Label fx:id="resultLabel" style="-fx-text-fill: green;" text=""/>

        <Button text="Back to Dashboard" onAction="#handleBack" prefWidth="160"/>
    </VBox>
</ScrollPane>
