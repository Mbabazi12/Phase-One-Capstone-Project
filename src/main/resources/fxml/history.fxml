<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.igirepay.lab3.controller.HistoryController">

    <top>
        <VBox style="-fx-padding: 20 20 10 20; -fx-spacing: 10;">
            <Label text="Transaction History" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
            <HBox spacing="10" style="-fx-alignment: center-left;">
                <Label text="Account:"/>
                <ComboBox fx:id="accountCombo" promptText="Select account" prefWidth="280"/>
                <Button text="Load History" onAction="#handleLoadHistory" prefWidth="130"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="historyTable">
            <columns>
                <TableColumn fx:id="colTxId"   text="Transaction ID" prefWidth="130"/>
                <TableColumn fx:id="colRefId"  text="Reference ID"   prefWidth="130"/>
                <TableColumn fx:id="colType"   text="Type"           prefWidth="120"/>
                <TableColumn fx:id="colAmount" text="Amount"         prefWidth="130"/>
                <TableColumn fx:id="colDate"   text="Date"           prefWidth="160"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox style="-fx-padding: 12;">
            <Button text="Back to Dashboard" onAction="#handleBack" prefWidth="160"/>
        </HBox>
    </bottom>
</BorderPane>
