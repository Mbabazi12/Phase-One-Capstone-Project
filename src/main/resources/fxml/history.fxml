<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.igirepay.lab3.controller.HistoryController"
            style="-fx-background-color: #f0f2f5;">

    <top>
        <VBox style="-fx-padding: 16 20 12 20; -fx-spacing: 10;
                     -fx-background-color: white;
                     -fx-border-color: #dde1e7; -fx-border-width: 0 0 1 0;">
            <Label text="Transaction History"
                   style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

            <!-- Filter row -->
            <HBox spacing="10" style="-fx-alignment: center-left;">
                <Label text="Account:" style="-fx-font-size: 12;"/>
                <ComboBox fx:id="accountCombo" promptText="Select account" prefWidth="200"/>

                <Label text="Type:" style="-fx-font-size: 12;"/>
                <ComboBox fx:id="typeFilterCombo" promptText="All types" prefWidth="160"/>

                <Label text="From:" style="-fx-font-size: 12;"/>
                <DatePicker fx:id="fromDatePicker" prefWidth="130"/>

                <Label text="To:" style="-fx-font-size: 12;"/>
                <DatePicker fx:id="toDatePicker" prefWidth="130"/>

                <Button text="Apply" onAction="#handleLoadHistory" prefWidth="80"
                        style="-fx-background-color: #2c3e50; -fx-text-fill: white;
                               -fx-background-radius: 5; -fx-padding: 6 12;"/>
                <Button text="Clear" onAction="#handleClearFilters" prefWidth="70"
                        style="-fx-background-color: transparent; -fx-text-fill: #7f8c8d;
                               -fx-border-color: #dde1e7; -fx-border-radius: 5;
                               -fx-background-radius: 5; -fx-padding: 6 12;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="historyTable"
                   style="-fx-background-color: white; -fx-font-size: 12;">
            <columns>
                <TableColumn fx:id="colDate"   text="Date"        prefWidth="155"/>
                <TableColumn fx:id="colType"   text="Type"        prefWidth="140"/>
                <TableColumn fx:id="colAmount" text="Amount"      prefWidth="130"/>
                <TableColumn fx:id="colStatus" text="Status"      prefWidth="90"/>
                <TableColumn fx:id="colDesc"   text="Description" prefWidth="260"/>
            </columns>
            <placeholder>
                <Label text="No transactions found for the selected filters."
                       style="-fx-text-fill: #aaa; -fx-font-size: 12;"/>
            </placeholder>
        </TableView>
    </center>

    <bottom>
        <HBox style="-fx-padding: 12; -fx-background-color: white;
                     -fx-border-color: #dde1e7; -fx-border-width: 1 0 0 0;">
            <Label fx:id="countLabel" text="" style="-fx-font-size: 11; -fx-text-fill: #7f8c8d;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Back to Dashboard" onAction="#handleBack" prefWidth="160"
                    style="-fx-background-color: transparent; -fx-text-fill: #2c3e50;
                           -fx-border-color: #2c3e50; -fx-border-radius: 5;
                           -fx-background-radius: 5; -fx-padding: 6 12;"/>
        </HBox>
    </bottom>

</BorderPane>
