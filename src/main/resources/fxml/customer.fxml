<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.igirepay.lab3.controller.CustomerController"
            style="-fx-background-color: #f0f2f5;">

    <center>
        <VBox alignment="CENTER" spacing="0" style="-fx-max-width: 400; -fx-pref-width: 400;">

            <!-- Card -->
            <VBox spacing="16"
                  style="-fx-background-color: white;
                         -fx-background-radius: 10;
                         -fx-padding: 36 40 32 40;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 12, 0, 0, 3);">

                <VBox spacing="4" style="-fx-alignment: center;">
                    <Label text="IgirePay"
                           style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <Label text="Create your account"
                           style="-fx-font-size: 12; -fx-text-fill: #7f8c8d;"/>
                </VBox>

                <!-- Full Name -->
                <VBox spacing="4">
                    <Label text="Full Name" style="-fx-font-size: 12; -fx-text-fill: #4a4a4a;"/>
                    <TextField fx:id="fullNameField" promptText="Your full name"
                               style="-fx-background-radius: 6; -fx-border-radius: 6;
                                      -fx-border-color: #dde1e7; -fx-padding: 8 10; -fx-font-size: 13;"/>
                </VBox>

                <!-- Phone -->
                <VBox spacing="4">
                    <Label text="Phone Number" style="-fx-font-size: 12; -fx-text-fill: #4a4a4a;"/>
                    <TextField fx:id="phoneField" promptText="10-digit phone number"
                               style="-fx-background-radius: 6; -fx-border-radius: 6;
                                      -fx-border-color: #dde1e7; -fx-padding: 8 10; -fx-font-size: 13;"/>
                </VBox>

                <!-- PIN section (hidden on update) -->
                <VBox fx:id="pinSection" spacing="12">
                    <VBox spacing="4">
                        <Label text="PIN (5 digits)" style="-fx-font-size: 12; -fx-text-fill: #4a4a4a;"/>
                        <PasswordField fx:id="pinField" promptText="5-digit PIN"
                                       style="-fx-background-radius: 6; -fx-border-radius: 6;
                                              -fx-border-color: #dde1e7; -fx-padding: 8 10; -fx-font-size: 13;"/>
                    </VBox>
                    <VBox spacing="4">
                        <Label text="Confirm PIN" style="-fx-font-size: 12; -fx-text-fill: #4a4a4a;"/>
                        <PasswordField fx:id="confirmPinField" promptText="Re-enter your PIN"
                                       style="-fx-background-radius: 6; -fx-border-radius: 6;
                                              -fx-border-color: #dde1e7; -fx-padding: 8 10; -fx-font-size: 13;"/>
                    </VBox>
                </VBox>

                <Label fx:id="messageLabel" text="" wrapText="true"
                       style="-fx-font-size: 12;"/>

                <!-- Buttons -->
                <VBox spacing="8">
                    <Button text="Register" onAction="#handleRegister" maxWidth="Infinity"
                            style="-fx-background-color: #2c3e50; -fx-text-fill: white;
                                   -fx-background-radius: 6; -fx-padding: 10;
                                   -fx-font-size: 13; -fx-font-weight: bold;"/>
                    <Button text="Save Changes" onAction="#handleUpdate" maxWidth="Infinity"
                            style="-fx-background-color: #1e7e4a; -fx-text-fill: white;
                                   -fx-background-radius: 6; -fx-padding: 10; -fx-font-size: 13;"/>
                    <Button text="← Back" onAction="#handleBack" maxWidth="Infinity"
                            style="-fx-background-color: transparent; -fx-text-fill: #7f8c8d;
                                   -fx-border-color: #dde1e7; -fx-border-radius: 6;
                                   -fx-background-radius: 6; -fx-padding: 9; -fx-font-size: 12;"/>
                </VBox>

            </VBox>
        </VBox>
    </center>

</BorderPane>
