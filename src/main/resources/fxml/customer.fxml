<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.igirepay.lab3.controller.CustomerController"
            fitToWidth="true" fitToHeight="false"
            style="-fx-padding: 0;">

    <VBox spacing="14" style="-fx-padding: 40;" minWidth="400">

        <Label text="Customer Registration / Update" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

        <Label text="Full Name"/>
        <TextField fx:id="fullNameField" promptText="Full name" maxWidth="400"/>

        <Label text="Phone Number"/>
        <TextField fx:id="phoneField" promptText="10-digit phone number" maxWidth="400"/>

        <Label text="PIN (5 digits)"/>
        <TextField fx:id="pinField" promptText="5-digit PIN" maxWidth="400"/>

        <Label fx:id="messageLabel" style="-fx-text-fill: green;" text=""/>

        <HBox spacing="10">
            <Button text="Register"     onAction="#handleRegister" prefWidth="140"/>
            <Button text="Save Changes" onAction="#handleUpdate"   prefWidth="140"/>
            <Button text="Back"         onAction="#handleBack"     prefWidth="100"/>
        </HBox>
    </VBox>
</ScrollPane>
