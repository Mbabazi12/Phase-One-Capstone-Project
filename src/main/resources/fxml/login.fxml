<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.igirepay.lab3.controller.LoginController"
            style="-fx-background-color: #f0f2f5;">

    <center>
        <VBox alignment="CENTER" spacing="0" style="-fx-max-width: 360; -fx-pref-width: 360;">

            <!-- Card -->
            <VBox spacing="18"
                  style="-fx-background-color: white;
                         -fx-background-radius: 10;
                         -fx-padding: 36 40 32 40;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 12, 0, 0, 3);">

                <!-- Logo / title -->
                <VBox spacing="4" style="-fx-alignment: center;">
                    <Label text="IgirePay"
                           style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <Label text="Sign in to your account"
                           style="-fx-font-size: 12; -fx-text-fill: #7f8c8d;"/>
                </VBox>

                <!-- Fields -->
                <VBox spacing="12">
                    <VBox spacing="4">
                        <Label text="Phone Number"
                               style="-fx-font-size: 12; -fx-text-fill: #4a4a4a;"/>
                        <TextField fx:id="phoneField" promptText="10-digit phone number"
                                   style="-fx-background-radius: 6; -fx-border-radius: 6;
                                          -fx-border-color: #dde1e7; -fx-padding: 8 10;
                                          -fx-font-size: 13;"/>
                    </VBox>
                    <VBox spacing="4">
                        <Label text="PIN"
                               style="-fx-font-size: 12; -fx-text-fill: #4a4a4a;"/>
                        <PasswordField fx:id="pinField" promptText="5-digit PIN"
                                       style="-fx-background-radius: 6; -fx-border-radius: 6;
                                              -fx-border-color: #dde1e7; -fx-padding: 8 10;
                                              -fx-font-size: 13;"/>
                    </VBox>
                </VBox>

                <Label fx:id="errorLabel" text="" wrapText="true"
                       style="-fx-text-fill: #c0392b; -fx-font-size: 12;"/>

                <!-- Buttons -->
                <VBox spacing="8">
                    <Button fx:id="loginButton" text="Sign In"
                            onAction="#handleLogin" maxWidth="Infinity"
                            style="-fx-background-color: #2c3e50; -fx-text-fill: white;
                                   -fx-background-radius: 6; -fx-padding: 10;
                                   -fx-font-size: 13; -fx-font-weight: bold;"/>
                    <Button text="Create an account"
                            onAction="#handleGoToRegister" maxWidth="Infinity"
                            style="-fx-background-color: transparent; -fx-text-fill: #2980b9;
                                   -fx-border-color: #2980b9; -fx-border-radius: 6;
                                   -fx-background-radius: 6; -fx-padding: 9;
                                   -fx-font-size: 13;"/>
                </VBox>

            </VBox>
        </VBox>
    </center>

</BorderPane>
